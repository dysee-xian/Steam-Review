            "avg_games_owned_p95": 550.434379,
            "avg_helpful_votes_p95": 6.481055
        }
    },
    "library_versions": {
        "scikit_learn": "1.6.1",
        "transformers": "5.20.2",
        "torch": "2.11.0+cpu"
    }
